HOST=127.0.0.1
PORT=3210
DATA_DIR=./data
# 리버스 프록시 또는 외부 공유 시 실제 접속 주소를 넣으세요.
# 예: https://fm.example.com (끝에 / 없이)
PUBLIC_ORIGIN=
# HTTPS에서만 true. 로컬 HTTP 미리보기는 false.
COOKIE_SECURE=false
# 최초 방 만들 때 사용하는 서버 초대 키. 빈 값이면 누구나 방 생성 가능.
SERVER_JOIN_KEY=
# 선택: 로컬 Ollama. 모델을 지정하지 않으면 사실 기반 경기 요약을 만듭니다.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# 자동 수집 뉴스: none(원문 공개 없이 대기), codex(호스트 CLI), ollama
NEWS_PROVIDER=none
CODEX_BIN=codex
