# 터치라인 서버 주소. 같은 PC라면 아래 값을 사용합니다.
TOUCHLINE_URL=http://127.0.0.1:3210
# 리그 운영자: 우리 리그 → FM 자동 수집 → 연결 키 만들기
COLLECTOR_TOKEN=
BRIDGE_URL=http://127.0.0.1:47831
# auto: 브리지 우선, 미연결 시 메시지함 OCR 변화 감지
# bridge: 게임 이벤트만 사용 / screen: 화면·OCR 변화 감지
# FM27은 현재 화면 OCR 수집 사용. FM26만 bridge/auto 지원.
FM_VERSION=27
FM_EXECUTABLE="C:\Program Files (x86)\Steam\steamapps\common\Football Manager 27\fm.exe"
CAPTURE_MODE=screen
POLL_MS=3000
CAPTURE_COOLDOWN_MS=15000
# 실행 시작 전 과거 이벤트는 건너뜁니다.
CAPTURE_BACKLOG=false
